# ========== API Keys & Secrets ==========
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://pinata.cloud/ — used for IPFS uploads
PINATA_JWT=your_pinata_jwt_here

# Secret for the /api/admin/resolve endpoint (human HITL)
ADMIN_SECRET=your_admin_secret_here

# ========== Node Configuration ==========
PORT=3001
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Minimum LLM confidence required before auto-submitting verdict on-chain (0.0 – 1.0)
LLM_CONFIDENCE_THRESHOLD=0.80

# ========== Contract & Wallet Configuration ==========
# WARNING: Never commit real private keys. Use the Hardhat default key for local dev only.
BACKEND_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BACKEND_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Run `npx hardhat run scripts/deploy.js --network localhost` and paste the addresses below
ESCROW_MANAGER_ADDRESS=0x_deployed_escrow_address
USDC_ADDRESS=0x_deployed_usdc_address
